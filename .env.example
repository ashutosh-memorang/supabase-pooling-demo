# Copy to .env and fill in. NEVER use a production or staging project.
# If a password contains special characters (@ : / ? # % etc.), URL-encode it in the strings below.

# 1) The app's connection string: Supabase Dashboard → Connect → "Transaction pooler" (port 6543).
#    This is the login your app uses (usually postgres). The username looks like postgres.<project-ref>.
APP_DATABASE_URL='postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres'

# 2) Delivery's OWN login on the same pooler. Pick any password: `npm run demo:setup`
#    creates the "delivery" login with exactly this name and password.
DELIVERY_DATABASE_URL='postgresql://delivery.<project-ref>:<choose-a-password>@aws-0-<region>.pooler.supabase.com:6543/postgres'

# 3) Safety: the scripts refuse to run unless both strings point at this project ref,
#    and you confirm it is a disposable test project.
ALLOWED_PROJECT_REF=<project-ref>
CONFIRM_DISPOSABLE=no

# --- Optional: only for the detailed lab (docs/LAB.md). Generated by `npm run lab:init-env`. ---
# PROJECT_REF=<project-ref>
# POOLER_HOST=aws-0-<region>.pooler.supabase.com
# POOLER_TRANSACTION_PORT=6543
# POOLER_SESSION_PORT=5432
# TEST_APP_PASSWORD=  TEST_DELIVERY_PASSWORD=  TEST_HUMAN_PASSWORD=  TEST_MAINT_PASSWORD=
# TEST_SHARED_PASSWORD=  TEST_MIGRATOR_PASSWORD=
